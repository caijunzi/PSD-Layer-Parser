{
    "preset_name": "textile_damask",
    "description": "软装装饰壁布/大马士革纹样 1:1 工业分层印前制版预设（2026-09-11 按新引擎契约重写：双产品线 + 印前算子 + 品类语义 SSOT）",
    "version": "2.0.0",

    "output": {
        "mode": "plate",
        "color_mode": "cmyk"
    },
    "dpi": 150.0,
    "bg_layer_name": "01_象牙织物底板_Ivory_Fabric_Base",
    "background_mode": "fabric_substrate",
    "plate_inpaint_method": "telea_ns",

    "print_condition": "iso_uncoated",

    "ai_semantic_classes": [
        {
            "name": "03_金箔卷草纹样_Gold_Filigree_Motif",
            "prompt": "gold foil ornament . golden filigree scrollwork . gilded pattern ."
        },
        {
            "name": "02_巴洛克团花_Baroque_Medallion",
            "prompt": "floral medallion . damask flower motif . ornate floral pattern ."
        }
    ],

    "rule_class_allowlist": ["02_巴洛克团花_Baroque_Medallion"],

    "layer_semantics": {
        "name_mapping": {},
        "layer_attributes": [
            {
                "match": ["金箔", "gold", "foil"],
                "blend_mode": "NORMAL",
                "opacity": 255,
                "comment": "金箔专色层不参与正片叠底（烫金为独立印版）"
            }
        ]
    },

    "plate_operators": {
        "contour_protection": { "enabled": true },
        "micro_holes": {
            "enabled": true,
            "params": { "dog_threshold": 5.0 },
            "layer_name": "12_激光冲孔挂点_DieCut_Perforations"
        },
        "trapping": {
            "enabled": true,
            "spot_layer_name": "02_巴洛克团花_Baroque_Medallion",
            "layer_name": "11_烫金陷印_Foil_Trap_Spot",
            "params": { "trap_mm": 0.2, "trap_type": "spread" },
            "comment": "工程验证用团花层充作专色；生产时 spot 应指向烫金版图层"
        }
    }
}
